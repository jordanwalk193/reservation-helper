{
  "name": "reservation-helper",
  "version": "0.4.7",
  "private": true,
  "description": "Desktop helper for Reserve America",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mwl",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win-arm": "electron-builder --win nsis --arm64",
    "publish": "electron-builder --publish always",
    "dist:linux": "electron-builder --linux deb AppImage"
  },
  "build": {
    "appId": "com.campingthing.reservationhelper",
    "productName": "Reservation Helper",
    "publish": {
      "provider": "github",
      "owner": "jordanwalk193",
      "repo": "reservation-helper",
      "private": false,
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "config.js",
      "config.example.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleName": "Reservation Helper",
        "CFBundleDisplayName": "Reservation Helper"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/reservation-helper-logo.png",
      "maintainer": "Reservation Helper <noreply@example.com>",
      "synopsis": "Campsite booking helper"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "node-machine-id": "^1.1.12",
    "posthog-node": "^5.11.2"
  },
  "homepage": "https://github.com/jordanwalk193/reservation-helper"
}
